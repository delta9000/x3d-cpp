<X3D version='4.0' profile='Immersive'>
  <Scene>
    <ProtoDeclare name='Leaf'>
      <ProtoBody><Group/></ProtoBody>
    </ProtoDeclare>
    <ProtoDeclare name='Wrap'>
      <ProtoBody>
        <Group>
          <ProtoDeclare name='Inner'>
            <ProtoBody><ProtoInstance name='Leaf'/></ProtoBody>
          </ProtoDeclare>
          <ProtoInstance name='Inner'/>
