// Compare readable spec defaults and selected explicit literal values.
#include <cassert>
#include <cmath>
#include <cstddef>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

{% for node in concrete_nodes %}
#include "x3d/nodes/{{ node.name }}.hpp"
{% endfor %}

using namespace x3d::core;

#define TEST_ASSERT(condition, message)                                        \
  do {                                                                         \
    ++g_assertions_run;                                                        \
    if (!(condition)) {                                                        \
      std::cerr << "Assertion failed: " << message << std::endl;              \
      g_all_tests_passed = false;                                             \
    }                                                                          \
  } while (0)

static bool g_all_tests_passed = true;
static long g_assertions_run = 0;

{% for n in nodes_ctx %}
static void test_{{ n.name }}() {
  std::cout << "\nTesting {{ n.name }}..." << std::endl;
  try {
    x3d::nodes::{{ n.name }} inst;  // instantiation smoke test
    (void)inst;
    {% for f in n.default_fields %}
    TEST_ASSERT(
        inst.{{ f.getter_name }}() == x3d::nodes::{{ n.name }}::getDefault{{ f.name_pascal }}(),
        "{{ n.name }}.{{ f.x3d_name }} default mismatch");
    {% endfor %}
  } catch (const std::exception& e) {
    std::cerr << "Failed to construct {{ n.name }}: " << e.what() << std::endl;
    g_all_tests_passed = false;
  }
}
{% endfor %}

{% for wk in well_known %}
static void test_pin_{{ loop.index }}() {
  x3d::nodes::{{ wk.node }} inst;
  TEST_ASSERT({{ wk.expr }}, "{{ wk.desc }}");
}
{% endfor %}

int main() {
  {% for n in nodes_ctx %}
  test_{{ n.name }}();
  {% endfor %}

  {% for wk in well_known %}
  test_pin_{{ loop.index }}();
  {% endfor %}

  std::cout << "\nRan " << g_assertions_run << " default-value assertions."
            << std::endl;

  if (g_all_tests_passed) {
    std::cout << "All tests passed successfully!" << std::endl;
    return 0;
  }
  std::cerr << "\nSome tests failed." << std::endl;
  return 1;
}
