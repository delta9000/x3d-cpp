@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/x3d_saiTargets.cmake")
# A target alias only: both names refer to the same compiled contract.
if(NOT TARGET x3d::sai_provider)
    add_library(x3d::sai_provider ALIAS x3d::sai)
endif()
check_required_components(x3d_sai)
