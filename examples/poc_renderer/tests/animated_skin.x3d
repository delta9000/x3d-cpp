<?xml version="1.0" encoding="UTF-8"?>
<X3D profile="Immersive" version="4.0"><Scene>
  <Viewpoint position="0 0 8"/>
  <HAnimHumanoid DEF="Humanoid" name="Humanoid">
    <Coordinate DEF="skinPoints" containerField="skinCoord" point="0 0 0 2 0 0 0 1 0"/>
    <Normal DEF="skinNormals" containerField="skinNormal" vector="0 0 1 0 0 1 0 0 1"/>
    <HAnimJoint DEF="arm" containerField="joints" name="arm" rotation="0 0 1 0" skinCoordIndex="0 1 2" skinCoordWeight="1 1 1"/>
    <HAnimJoint USE="arm" containerField="skeleton"/>
    <Shape containerField="skin"><Appearance><Material diffuseColor="0.8 0.3 0.1"/></Appearance>
      <IndexedFaceSet coordIndex="0 1 2 -1" solid="false"><Coordinate USE="skinPoints"/><Normal USE="skinNormals"/></IndexedFaceSet>
    </Shape>
  </HAnimHumanoid>
  <TimeSensor DEF="Clock" cycleInterval="3" loop="true"/>
  <OrientationInterpolator DEF="Move" key="0 0.5 1" keyValue="0 0 1 0 0 0 1 1.57079632679 0 0 1 3.14159265359"/>
  <ROUTE fromNode="Clock" fromField="fraction_changed" toNode="Move" toField="set_fraction"/>
  <ROUTE fromNode="Move" fromField="value_changed" toNode="arm" toField="set_rotation"/>
</Scene></X3D>
